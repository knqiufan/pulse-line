{
  "name": "pulse-line",
  "version": "1.0.0",
  "description": "Customizable status bar for Claude Code",
  "main": "dist/src/index.js",
  "bin": {
    "pulse-line": "./bin/pulse-line.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "test": "node --test dist/test/**/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/",
    "bin/",
    "commands/",
    ".claude-plugin/",
    "skills/"
  ],
  "keywords": [
    "claude-code",
    "statusline",
    "status-bar",
    "monitoring",
    "pulse-line"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "commander": "^14.0.3"
  }
}
