{
  "name": "pulse-line",
  "version": "1.0.6",
  "description": "Customizable status bar for Claude Code",
  "main": "dist/src/index.js",
  "bin": {
    "pulse-line": "./bin/pulse-line.js"
  },
  "scripts": {
    "build": "tsc",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "watch": "tsc -w",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "test": "node scripts/test.js",
    "version-sync": "node scripts/sync-versions.js",
    "prepublishOnly": "npm run version-sync && npm run build"
  },
  "files": [
    "dist/",
    "bin/",
    "commands/",
    "hooks/",
    "scripts/",
    ".claude-plugin/",
    "skills/"
  ],
  "keywords": [
    "claude-code",
    "statusline",
    "status-bar",
    "monitoring",
    "pulse-line"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "commander": "^14.0.3"
  }
}
